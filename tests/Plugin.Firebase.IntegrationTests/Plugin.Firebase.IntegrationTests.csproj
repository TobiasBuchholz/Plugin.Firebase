<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="Plugin.Firebase.IntegrationTests.props.user" Condition="Exists('Plugin.Firebase.IntegrationTests.props.user')" />

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Plugin.Firebase.IntegrationTests</RootNamespace>
		<UseMaui>true</UseMaui>
        <MauiVersion>10.0.20</MauiVersion>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>

		<!-- Display name -->
		<ApplicationTitle>Plugin Firebase Integration Tests</ApplicationTitle>

		<!-- App Identifier -->
		<IntegrationTestsIosApplicationId Condition="'$(IntegrationTestsIosApplicationId)' == ''">plugin.firebase.integrationtests</IntegrationTestsIosApplicationId>
		<IntegrationTestsAndroidApplicationId Condition="'$(IntegrationTestsAndroidApplicationId)' == ''">plugin.firebase.integrationtests</IntegrationTestsAndroidApplicationId>
		<ApplicationIdGuid>06C3A02E-0965-4D7F-9E22-1902C6448F87</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    </ItemGroup>
    
    <!-- ios entitlements -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(_IsPublishing)' != 'true' and $([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').StartsWith('osx-'))">$([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').Replace('osx-', 'iossimulator-'))</RuntimeIdentifier>
        <ApplicationId>$(IntegrationTestsIosApplicationId)</ApplicationId>
        <CodesignEntitlements Condition="'$(CodesignEntitlements)' == ''">Platforms\iOS\Entitlements.plist</CodesignEntitlements>
        <EnableCodeSigning Condition="'$(EnableCodeSigning)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator'))">false</EnableCodeSigning>
        <FirebaseCrashlyticsUploadSymbolsEnabled>false</FirebaseCrashlyticsUploadSymbolsEnabled>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <ApplicationId>$(IntegrationTestsAndroidApplicationId)</ApplicationId>
        <DeviceRunnersAndroidActivityName>plugin.firebase.integrationtests.MainActivity</DeviceRunnersAndroidActivityName>
    </PropertyGroup>

    <!-- project references -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\Bundled\Bundled.csproj" />
    </ItemGroup>

    <!-- nuget packages -->
    <ItemGroup>
        <PackageReference Include="DeviceRunners.UITesting.Maui" Version="0.1.0-preview.12" />
        <PackageReference Include="DeviceRunners.Testing.Targets" Version="0.1.0-preview.12" />
        <PackageReference Include="DeviceRunners.VisualRunners.Maui" Version="0.1.0-preview.12" />
        <PackageReference Include="DeviceRunners.VisualRunners.Xunit" Version="0.1.0-preview.12" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.utility" Version="2.9.3" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.10.1.3" />
        <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.10.1.3" />
        <PackageReference Include="Xamarin.AndroidX.Collection.Jvm" Version="1.5.0.3" />
        <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.3" />
        <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.8.1" />
        <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.8.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.9.2.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.9.2.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.9.2.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.9.2.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.9.2.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.9.2.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.9.2.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.9.2.1" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.9.2.1" />
    </ItemGroup>

    <!-- platform assets -->
    <ItemGroup>
      <BundleResource Include="GoogleService-Info.plist" Condition="Exists('GoogleService-Info.plist')" />
    </ItemGroup>

    <ItemGroup>
      <GoogleServicesJson Include="google-services.json" Condition="Exists('google-services.json')" />
    </ItemGroup>

    <!--
      DeviceRunners injects its own runtime configuration into Android builds that
      are launched by dotnet test. Mirror the integration-test settings so the
      Android app receives the same host configuration as the iOS simulator.
    -->
    <Target
      Name="AddPluginFirebaseAndroidTestEnvironment"
      BeforeTargets="_GenerateEnvironmentFiles"
      Condition="
        $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'
        and '$(DeviceRunnersTestRun)' == 'true'
      ">
      <ItemGroup>
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_TEST_BACKEND=$(PLUGIN_FIREBASE_TEST_BACKEND)'))" Condition="'$(PLUGIN_FIREBASE_TEST_BACKEND)' != ''" />

        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_RUN_APPCHECK_TOKEN_TESTS=$(PLUGIN_FIREBASE_RUN_APPCHECK_TOKEN_TESTS)'))" Condition="'$(PLUGIN_FIREBASE_RUN_APPCHECK_TOKEN_TESTS)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_RUN_FCM_TOKEN_TESTS=$(PLUGIN_FIREBASE_RUN_FCM_TOKEN_TESTS)'))" Condition="'$(PLUGIN_FIREBASE_RUN_FCM_TOKEN_TESTS)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_RUN_FCM_DELIVERY_TESTS=$(PLUGIN_FIREBASE_RUN_FCM_DELIVERY_TESTS)'))" Condition="'$(PLUGIN_FIREBASE_RUN_FCM_DELIVERY_TESTS)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_FORCE_CRASHLYTICS_CRASH=$(PLUGIN_FIREBASE_FORCE_CRASHLYTICS_CRASH)'))" Condition="'$(PLUGIN_FIREBASE_FORCE_CRASHLYTICS_CRASH)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_EXPECT_PREVIOUS_CRASH=$(PLUGIN_FIREBASE_EXPECT_PREVIOUS_CRASH)'))" Condition="'$(PLUGIN_FIREBASE_EXPECT_PREVIOUS_CRASH)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_RUN_INSTALLATIONS_DELETE_TESTS=$(PLUGIN_FIREBASE_RUN_INSTALLATIONS_DELETE_TESTS)'))" Condition="'$(PLUGIN_FIREBASE_RUN_INSTALLATIONS_DELETE_TESTS)' != ''" />

        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_RUN_PHONE_AUTH_TESTS=$(PLUGIN_FIREBASE_RUN_PHONE_AUTH_TESTS)'))" Condition="'$(PLUGIN_FIREBASE_RUN_PHONE_AUTH_TESTS)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_PHONE_AUTH_NUMBER=$(PLUGIN_FIREBASE_PHONE_AUTH_NUMBER)'))" Condition="'$(PLUGIN_FIREBASE_PHONE_AUTH_NUMBER)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_PHONE_AUTH_CODE=$(PLUGIN_FIREBASE_PHONE_AUTH_CODE)'))" Condition="'$(PLUGIN_FIREBASE_PHONE_AUTH_CODE)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_PHONE_AUTH_VERIFICATION_ID=$(PLUGIN_FIREBASE_PHONE_AUTH_VERIFICATION_ID)'))" Condition="'$(PLUGIN_FIREBASE_PHONE_AUTH_VERIFICATION_ID)' != ''" />

        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_USE_AUTH_EMULATOR=$(PLUGIN_FIREBASE_USE_AUTH_EMULATOR)'))" Condition="'$(PLUGIN_FIREBASE_USE_AUTH_EMULATOR)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_AUTH_EMULATOR_HOST=$(PLUGIN_FIREBASE_AUTH_EMULATOR_HOST)'))" Condition="'$(PLUGIN_FIREBASE_AUTH_EMULATOR_HOST)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_AUTH_EMULATOR_PORT=$(PLUGIN_FIREBASE_AUTH_EMULATOR_PORT)'))" Condition="'$(PLUGIN_FIREBASE_AUTH_EMULATOR_PORT)' != ''" />

        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_USE_FIRESTORE_EMULATOR=$(PLUGIN_FIREBASE_USE_FIRESTORE_EMULATOR)'))" Condition="'$(PLUGIN_FIREBASE_USE_FIRESTORE_EMULATOR)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_FIRESTORE_EMULATOR_HOST=$(PLUGIN_FIREBASE_FIRESTORE_EMULATOR_HOST)'))" Condition="'$(PLUGIN_FIREBASE_FIRESTORE_EMULATOR_HOST)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_FIRESTORE_EMULATOR_PORT=$(PLUGIN_FIREBASE_FIRESTORE_EMULATOR_PORT)'))" Condition="'$(PLUGIN_FIREBASE_FIRESTORE_EMULATOR_PORT)' != ''" />

        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_USE_FUNCTIONS_EMULATOR=$(PLUGIN_FIREBASE_USE_FUNCTIONS_EMULATOR)'))" Condition="'$(PLUGIN_FIREBASE_USE_FUNCTIONS_EMULATOR)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_FUNCTIONS_EMULATOR_HOST=$(PLUGIN_FIREBASE_FUNCTIONS_EMULATOR_HOST)'))" Condition="'$(PLUGIN_FIREBASE_FUNCTIONS_EMULATOR_HOST)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_FUNCTIONS_EMULATOR_PORT=$(PLUGIN_FIREBASE_FUNCTIONS_EMULATOR_PORT)'))" Condition="'$(PLUGIN_FIREBASE_FUNCTIONS_EMULATOR_PORT)' != ''" />

        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_USE_STORAGE_EMULATOR=$(PLUGIN_FIREBASE_USE_STORAGE_EMULATOR)'))" Condition="'$(PLUGIN_FIREBASE_USE_STORAGE_EMULATOR)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_STORAGE_EMULATOR_HOST=$(PLUGIN_FIREBASE_STORAGE_EMULATOR_HOST)'))" Condition="'$(PLUGIN_FIREBASE_STORAGE_EMULATOR_HOST)' != ''" />
        <_GeneratedAndroidEnvironment Include="$([MSBuild]::Escape('PLUGIN_FIREBASE_STORAGE_EMULATOR_PORT=$(PLUGIN_FIREBASE_STORAGE_EMULATOR_PORT)'))" Condition="'$(PLUGIN_FIREBASE_STORAGE_EMULATOR_PORT)' != ''" />
      </ItemGroup>
    </Target>

    <!--
      DeviceRunners preview.12 assumes that the launcher is .MainActivity. The
      Android toolchain requires a fully qualified ActivityAttribute.Name, so
      pass that name explicitly while allowing ApplicationId to be overridden.
    -->
    <Target
      Name="SetDeviceRunnersAndroidActivity"
      AfterTargets="_DeviceRunnersAndroidArgs"
      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
      <PropertyGroup>
        <_DeviceRunnersCliArgs>$(_DeviceRunnersCliArgs) --activity &quot;$(DeviceRunnersAndroidActivityName)&quot;</_DeviceRunnersCliArgs>
      </PropertyGroup>
    </Target>

    <Target
      Name="ResignSimulatorRuntimeLibraries"
      AfterTargets="Build"
      Condition="
        $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'
        and !$([System.String]::IsNullOrEmpty('$(RuntimeIdentifier)'))
        and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator'))
      ">
      <PropertyGroup>
        <_SimulatorAppBundlePath>$(OutputPath)$(AssemblyName).app</_SimulatorAppBundlePath>
      </PropertyGroup>

      <!--
        Xcode 26 / macOS 26 rejects the Microsoft-signed simulator runtime dylibs
        with "Code Signature Invalid" before the test runner starts. Re-sign them
        ad hoc to match the generated simulator app bundle.
      -->
      <Exec
        Condition="Exists('$(_SimulatorAppBundlePath)/libxamarin-dotnet.dylib')"
        Command="codesign --force --sign - &quot;$(_SimulatorAppBundlePath)/libxamarin-dotnet.dylib&quot;" />
      <Exec
        Condition="Exists('$(_SimulatorAppBundlePath)/libxamarin-dotnet-debug.dylib')"
        Command="codesign --force --sign - &quot;$(_SimulatorAppBundlePath)/libxamarin-dotnet-debug.dylib&quot;" />
      <Exec
        Condition="Exists('$(_SimulatorAppBundlePath)')"
        Command="codesign --force --sign - --deep &quot;$(_SimulatorAppBundlePath)&quot;" />
    </Target>
</Project>
